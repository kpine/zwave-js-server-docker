{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Earthfile base images",
      "managerFilePatterns": [
        "/(^|/)Earthfile$/"
      ],
      "matchStrings": [
        "FROM (?<depName>[a-z0-9][a-z0-9._/-]*):(?<currentValue>[\\w.-]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Group Z-Wave JS packages; zwave-js and @zwave-js/flash must stay on the same version",
      "matchPackageNames": [
        "zwave-js",
        "@zwave-js/flash",
        "@zwave-js/server"
      ],
      "groupName": "Z-Wave JS"
    },
    {
      "description": "Automerge minor/patch Z-Wave JS updates; merging to main triggers a release",
      "matchPackageNames": [
        "zwave-js",
        "@zwave-js/flash",
        "@zwave-js/server"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "minimumReleaseAge": "14 days",
      "groupName": "GitHub Actions"
    },
    {
      "description": "Track Earthfile base image tags only, without digest pinning",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": false
    }
  ]
}
