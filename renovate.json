{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on the first day of the month"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Earthfile base images",
      "managerFilePatterns": [
        "/(^|/)Earthfile$/"
      ],
      "matchStrings": [
        "FROM (?<depName>[a-z0-9][a-z0-9._/-]*):(?<currentValue>[\\w.-]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "FROM {{depName}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Earthfile ARGs annotated with a renovate comment",
      "managerFilePatterns": [
        "/(^|/)Earthfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\s+ARG [A-Z0-9_]+=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Group Z-Wave JS packages; zwave-js and @zwave-js/flash must stay on the same version",
      "matchPackageNames": [
        "zwave-js",
        "@zwave-js/flash",
        "@zwave-js/server"
      ],
      "groupName": "Z-Wave JS"
    },
    {
      "description": "Automerge minor/patch Z-Wave JS updates; merging to main triggers a release",
      "matchPackageNames": [
        "zwave-js",
        "@zwave-js/flash",
        "@zwave-js/server"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Alpine minor bumps change the release branch: update the alpine_3_XX/nodejs depName in the Earthfile in the same PR",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "alpine"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "prBodyNotes": [
        "⚠️ Update the `alpine_3_XX/nodejs` renovate comment and `NODEJS_VERSION` in the Earthfile to match the new Alpine branch."
      ]
    }
  ]
}
